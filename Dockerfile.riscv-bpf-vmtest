FROM ubuntu:resolute

ARG DEBIAN_FRONTEND=noninteractive
 
RUN apt-get update && apt-get install --yes --no-install-recommends \
	bc \
	bison \
	bzip2 \
	ca-certificates \
	ccache \
	cmake \
	cpio \
	curl \
	flex \
	gcc \
	g++ \
	gcc-riscv64-linux-gnu \
	g++-riscv64-linux-gnu \
	git \
	libcap-dev \
	libdw-dev \
	libdwarf-dev \
	libelf-dev \
	libglib2.0-dev \
	libncurses-dev \
	libssl-dev \
	lsb-release \
	make \
	ninja-build \
	python3-docutils \
	python3-venv \
	rsync \
	sudo \
	vim \
	wget \
	xz-utils \
	zstd

# llvm 21
RUN echo 'deb [arch=amd64] http://apt.llvm.org/resolute/ llvm-toolchain-resolute-21 main' > /etc/apt/sources.list.d/llvm.list
RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc
RUN apt-get update && apt-get install --yes clang-21 llvm-21 lld-21

# pahole
RUN cd $(mktemp -d) && git clone https://git.kernel.org/pub/scm/devel/pahole/pahole.git --depth=1 && \
    cd pahole && mkdir build && cd build && cmake -DBUILD_SHARED_LIBS=OFF .. && make -j$(nproc) install

# qemu 11.1.0
RUN cd $(mktemp -d) && wget -q https://download.qemu.org/qemu-11.1.0.tar.xz && tar xJf qemu-11.1.0.tar.xz && \
    cd qemu-11.1.0 && ./configure --target-list=riscv64-softmmu && make install -j$(nproc)

# copy rootfs
COPY image/libbpf-vmtest-rootfs-2026.08.17-resolute-riscv64.tar.zst /root

# riscv64 dependencies
RUN dpkg --add-architecture riscv64
RUN sed -i '/Signed-By/a\Architectures: amd64' /etc/apt/sources.list.d/ubuntu.sources
RUN echo ' \
deb [arch=riscv64] http://ports.ubuntu.com/ubuntu-ports resolute main restricted multiverse universe\n \
deb [arch=riscv64] http://ports.ubuntu.com/ubuntu-ports resolute-updates main\n \
deb [arch=riscv64] http://ports.ubuntu.com/ubuntu-ports resolute-security main\n' \
>> /etc/apt/sources.list.d/riscv64.list

RUN apt-get update && apt-get install --yes --no-install-recommends \
	libcap-dev:riscv64 \
	libelf-dev:riscv64 \
	libssl-dev:riscv64

RUN ln -s /usr/bin/llc-21 /usr/bin/llc
RUN ln -s /usr/bin/clang-21 /usr/bin/clang
RUN ln -s /usr/bin/llvm-strip-21 /usr/bin/llvm-strip
RUN ln -s /usr/bin/llvm-config-21 /usr/bin/llvm-config

# Route compiler invocations through ccache. vmtest.sh builds its own make
# command line, so instead of touching it, shadow the compilers with ccache
# symlinks (masquerade mode): ccache resolves the real compiler from its own
# name and the kernel + selftests builds are cached without any changes
# upstream. A mounted volume at /ccache (workflow cache) persists objects.
RUN mkdir -p /usr/local/ccache-bin && \
	for cc in gcc g++ cc c++ clang clang-21 clang++ clang++-21 \
	          riscv64-linux-gnu-gcc riscv64-linux-gnu-g++; do \
		if command -v "$cc" > /dev/null 2>&1; then \
			ln -s /usr/bin/ccache "/usr/local/ccache-bin/$cc"; \
		fi; \
	done
RUN printf '%s\n' \
	'sloppiness = file_macro,locale,time_macros,include_file_mtime,include_file_ctime' \
	'hash_dir = false' \
	'compiler_check = content' \
	'max_size = 5G' > /etc/ccache.conf
ENV PATH="/usr/local/ccache-bin:${PATH}"
ENV CCACHE_DIR="/ccache"

RUN git config --global --add safe.directory '*'

RUN apt-get clean && rm -rf /var/lib/apt/lists/
RUN rm -fr /tmp/*

# The workspace volume is for bind-mounted source trees.
VOLUME /workspace
WORKDIR /workspace
