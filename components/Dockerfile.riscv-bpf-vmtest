FROM ubuntu:resolute

ARG DEBIAN_FRONTEND=noninteractive

# --------------------------------------------------------------------------
# 1. General host build tools
# --------------------------------------------------------------------------
RUN apt-get update && apt-get install --yes --no-install-recommends \
        bc \
        bison \
        bzip2 \
        ca-certificates \
        ccache \
        cmake \
        cpio \
        curl \
        flex \
        gcc \
        g++ \
        git \
        gnupg \
        libcap-dev \
        libdw-dev \
        libdwarf-dev \
        libelf-dev \
        libglib2.0-dev \
        libncurses-dev \
        libssl-dev \
        lsb-release \
        make \
        ninja-build \
        python3-docutils \
        python3-venv \
        rsync \
        sudo \
        vim \
        wget \
        xz-utils \
        zstd && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------------------------------
# 2. RISC-V 64 cross-compilation toolchain and target libraries
# --------------------------------------------------------------------------
RUN dpkg --add-architecture riscv64 && \
    sed -i '/Signed-By/a\Architectures: amd64' /etc/apt/sources.list.d/ubuntu.sources && \
    printf '%s\n' \
        'deb [arch=riscv64] http://ports.ubuntu.com/ubuntu-ports resolute main restricted multiverse universe' \
        'deb [arch=riscv64] http://ports.ubuntu.com/ubuntu-ports resolute-updates main' \
        'deb [arch=riscv64] http://ports.ubuntu.com/ubuntu-ports resolute-security main' \
        > /etc/apt/sources.list.d/riscv64.list && \
    apt-get update && apt-get install --yes --no-install-recommends \
        gcc-riscv64-linux-gnu \
        g++-riscv64-linux-gnu \
        libcap-dev:riscv64 \
        libelf-dev:riscv64 \
        libssl-dev:riscv64 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------------------------------
# 3. LLVM 21 toolchain
# --------------------------------------------------------------------------
RUN echo 'deb [arch=amd64] http://apt.llvm.org/resolute/ llvm-toolchain-resolute-21 main' > /etc/apt/sources.list.d/llvm.list && \
    wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key > /etc/apt/trusted.gpg.d/apt.llvm.org.asc && \
    apt-get update && apt-get install --yes --no-install-recommends \
        clang-21 \
        lld-21 \
        llvm-21 && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    ln -s /usr/bin/clang-21       /usr/bin/clang && \
    ln -s /usr/bin/clang++-21     /usr/bin/clang++ && \
    ln -s /usr/bin/llc-21         /usr/bin/llc && \
    ln -s /usr/bin/llvm-strip-21  /usr/bin/llvm-strip && \
    ln -s /usr/bin/llvm-config-21 /usr/bin/llvm-config

# --------------------------------------------------------------------------
# 4. Pahole (built from source)
# --------------------------------------------------------------------------
RUN DIR=$(mktemp -d) && \
    git clone --depth=1 https://git.kernel.org/pub/scm/devel/pahole/pahole.git "$DIR/pahole" && \
    cmake -B "$DIR/pahole/build" -S "$DIR/pahole" -DBUILD_SHARED_LIBS=OFF && \
    make -C "$DIR/pahole/build" -j$(nproc) install && \
    strip /usr/local/bin/pahole && \
    rm -rf "$DIR"

# --------------------------------------------------------------------------
# 5. QEMU 11.1.0 (built from source)
# --------------------------------------------------------------------------
RUN DIR=$(mktemp -d) && \
    wget -qO- https://download.qemu.org/qemu-11.1.0.tar.xz | tar -xJ -C "$DIR" && \
    cd "$DIR/qemu-11.1.0" && \
    ./configure --target-list=riscv64-softmmu --disable-docs --disable-user --disable-guest-agent && \
    make -j$(nproc) install && \
    strip /usr/local/bin/qemu-system-riscv64 && \
    rm -rf "$DIR"

# --------------------------------------------------------------------------
# 6. Ccache masquerade and build configuration
# --------------------------------------------------------------------------
RUN mkdir -p /usr/local/ccache-bin && \
    for cc in gcc g++ cc c++ clang clang-21 clang++ clang++-21 \
              riscv64-linux-gnu-gcc riscv64-linux-gnu-g++; do \
        [ -x "/usr/bin/$cc" ] && ln -s /usr/bin/ccache "/usr/local/ccache-bin/$cc"; \
    done && \
    printf '%s\n' \
        'sloppiness = file_macro,locale,time_macros,include_file_mtime,include_file_ctime' \
        'hash_dir = false' \
        'compiler_check = content' \
        'max_size = 5G' > /etc/ccache.conf

ENV PATH="/usr/local/ccache-bin:${PATH}"
ENV CCACHE_DIR="/ccache"

RUN git config --global --add safe.directory '*'

# --------------------------------------------------------------------------
# 7. Rootfs image and workspace
# --------------------------------------------------------------------------
COPY components/libbpf-vmtest-rootfs-2026.08.17-resolute-riscv64.tar.zst /root/

VOLUME /workspace
WORKDIR /workspace
